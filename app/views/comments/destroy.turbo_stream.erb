<%= turbo_stream.remove @comment %>
<%= turbo_stream.update "comment-count-#{@article.id}" do %>
  <%= t('comments.comments_title', count: @article.comments.kept.count) %>
<% end %>
<% if @comment.parent_id? %>
  <%#= turbo_stream.update "reply-count-#{@comment.parent_id}" do %>
<%# end %>
  <%= turbo_stream.update "reply-count-#{@comment.parent_id}" do %>
    <% if @comment.parent.replies.kept.any? %>
      <%= t('comment_partial.view_replies', count: @comment.parent.replies.kept.count) %>
    <% else %>
      <span class="hidden"></span>
    <% end %>
  <% end %>

<% end %>