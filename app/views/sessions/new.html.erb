<div class="max-w-lg mx-auto mt-10 p-8 border border-gray-200 rounded-lg shadow-sm">
  <h1 class="text-2xl font-bold text-center mb-6"><%= t('sessions_new.title') %></h1>

  <%= form_with url: login_path, scope: :session, class: "space-y-6" do |form| %>
    <%= hidden_field_tag :locale, I18n.locale %>
    <div>
      <%= form.label :login, t('sessions_new.email_or_username_label'), class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :login, value: params.dig(:session, :login), class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>
    <div>
      <%= form.label :password, t('sessions_new.password_label'), class: "block text-sm font-medium text-gray-700" %>
      <%= form.password_field :password, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>
    <div class="flex items-center">
      <%= form.check_box :remember_me, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
      <%= form.label :remember_me, t('sessions_new.remember_me_label'), class: "ml-2 block text-sm text-gray-900" %>
    </div>
    <div class="text-sm text-center mt-4">
      <%= link_to t('sessions_new.forgot_password_link'), new_password_reset_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
    </div>

    <div>
      <%= form.submit t('sessions_new.submit_button'), class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
    </div>
  <% end %>
</div>