<div class="p-4 sm:p-6 lg:p-8">
  <h1 class="text-3xl font-bold tracking-tight text-gray-900 mb-6"><%= t('admin_dashboard.title') %></h1>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
      <h3 class="text-sm font-medium text-gray-500 truncate"><%= t('admin_dashboard.stats.total_users') %></h3>
      <p class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= @total_users %></p>
    </div>
    <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
      <h3 class="text-sm font-medium text-gray-500 truncate"><%= t('admin_dashboard.stats.total_articles') %></h3>
      <p class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= @total_articles %></p>
    </div>
    <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
      <h3 class="text-sm font-medium text-gray-500 truncate"><%= t('admin_dashboard.stats.total_comments') %></h3>
      <p class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= @total_comments %></p>
    </div>
    <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
      <h3 class="text-sm font-medium text-gray-500 truncate"><%= t('admin_dashboard.stats.total_claps') %></h3>
      <p class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= @total_claps %></p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
      <h3 class="text-lg font-medium text-gray-900 mb-4"><%= t('admin_dashboard.charts.users_per_week') %></h3>
      <%= line_chart @users_per_week, xtitle: t('admin_dashboard.charts.date_axis'), ytitle: t('admin_dashboard.charts.new_users_axis'), colors: ["#3b82f6"] %>
    </div>
    <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
      <h3 class="text-lg font-medium text-gray-900 mb-4"><%= t('admin_dashboard.charts.articles_per_week') %></h3>
      <%= area_chart @articles_per_week, xtitle: t('admin_dashboard.charts.date_axis'), ytitle: t('admin_dashboard.charts.new_articles_axis'), colors: ["#10b981"] %>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
    <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-medium text-gray-900"><%= t('admin_dashboard.moderation_queue.title') %></h3>
        <%= link_to t('admin_dashboard.moderation_queue.view_all'), admin_moderation_path, class: "text-sm font-medium text-indigo-600 hover:underline" %>
      </div>
      <div class="flow-root">
        <% if @actionable_items.any? %>
          <ul role="list" class="-my-5 divide-y divide-gray-200">
            <% @actionable_items.each do |item| %>
              <li class="py-4">
                <div class="flex items-center space-x-4">
                  <div class="flex-1 min-w-0">

                    <%# --- Logic to determine item type and status --- %>
                    <% is_article = item.is_a?(Article) %>
                    <% is_review_request = is_article && item.moderation_records.any?(&:pending_review?) %>

                    <%# --- Display Title and Link --- %>
                    <p class="text-sm font-medium text-gray-900 truncate">
                      <% if is_article %>
                        <%= t('admin_dashboard.moderation_queue.article_prefix') %><%= link_to item.title, admin_moderation_path(scope: 'articles'), class: "text-blue-600 hover:underline" %>
                      <% else %>
                        <%= t('admin_dashboard.moderation_queue.comment_on_prefix') %><%= link_to item.article.title, admin_moderation_path(scope: 'comments'), class: "text-blue-600 hover:underline" %>
                      <% end %>
                    </p>

                    <%# --- Display Reason/Note --- %>
                    <p class="text-sm text-gray-500 truncate italic">
                      <% if is_review_request %>
                        <%= t('admin_dashboard.moderation_queue.author_note_prefix') %>"<%= item.moderation_records.pending_review.last.author_note %>"
                      <% else %>
                        "<%= truncate(item.reports.pending.last.reason, length: 70) %>"
                      <% end %>
                    </p>

                    <%# --- Display Actor and Timestamp --- %>
                    <p class="text-xs text-gray-400">
                      <% if is_review_request %>
                        <%= t('admin_dashboard.moderation_queue.requested_by_prefix') %><%= item.user.name %>
                      <% else %>
                        <%= t('admin_dashboard.moderation_queue.reported_by_prefix') %><%= item.reports.pending.last.user.name %>
                      <% end %>
                      <%= time_ago_in_words(item.updated_at) %> ago
                    </p>
                  </div>

                  <%# --- Display Status Badge --- %>
                  <div>
                    <% if is_review_request %>
                      <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10"><%= t('admin_dashboard.moderation_queue.status_awaiting_review') %></span>
                    <% else %>
                      <span class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-700/10"><%= t('admin_dashboard.moderation_queue.status_reported') %></span>
                    <% end %>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-center text-gray-500 py-4"><%= t('admin_dashboard.moderation_queue.empty_message') %></p>
        <% end %>
      </div>
    </div>
    <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
      <h3 class="text-lg font-medium text-gray-900 mb-4"><%= t('admin_dashboard.spotlight.title') %></h3>
      <div class="space-y-4">
        <div>
          <h4 class="text-sm font-semibold text-gray-600 mb-2"><%= t('admin_dashboard.spotlight.most_clapped') %></h4>
          <ul class="divide-y divide-gray-200">
            <% @most_clapped_articles.each do |article| %>
              <li class="py-2 flex justify-between items-center">
                <%= link_to article.title, article, class: "text-sm text-blue-600 hover:underline" %>
                <span class="text-sm font-mono bg-gray-100 px-2 py-0.5 rounded"><%= t('admin_dashboard.spotlight.claps_count', count: article.claps_count) %></span>
              </li>
            <% end %>
          </ul>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-gray-600 mb-2"><%= t('admin_dashboard.spotlight.most_commented') %></h4>
          <ul class="divide-y divide-gray-200">
            <% @most_commented_articles.each do |article| %>
              <li class="py-2 flex justify-between items-center">
                <%= link_to article.title, article, class: "text-sm text-blue-600 hover:underline" %>
                <span class="text-sm font-mono bg-gray-100 px-2 py-0.5 rounded"><%= t('admin_dashboard.spotlight.comments_count', count: article.comments_count) %></span>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>